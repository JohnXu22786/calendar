# --- dsh-calendar credential configuration ---
# Never commit this file. Secrets are only ever read from the environment,
# the dsh credential service, or the chmod-0600 local credential store.
#
# 1) Basic-auth CalDAV (Nextcloud, iCloud, any generic server)
# CALDAV_URL=https://nextcloud.example.com/remote.php/dav/calendars/me/personal/
# CALDAV_USERNAME=me@example.com
# CALDAV_PASSWORD=super-secret
#
# 2) Google Calendar (OAuth2 device flow -> refresh token)
# GOOGLE_CLIENT_ID=XXXX.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=XXXX            # only needed for refresh exchange on some flows
# Optional: pre-seed a refresh token (otherwise run `dsh-calendar auth google --device`)
# GOOGLE_CALDAV_REFRESH_TOKEN=XXXX
#
# 3) Defaults (all optional)
# DSH_CALENDAR_DEFAULT_TZ=Asia/Shanghai
# DSH_CALENDAR_TARGET=primary          # calendar resource id to use when not specified
# DSH_CALENDAR_CRED_FILE=.calendar-credentials.json
